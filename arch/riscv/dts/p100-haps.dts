/dts-v1/;
/ {
	model = "zhihe p100";
	compatible = "zhihe,p100";
	#address-cells = <2>;
	#size-cells = <2>;

	memory@80000000  {
		device_type = "memory";
		reg = <0x00 0x80000000  0x01 0x00000000>; /* 2G */
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
	};
	aliases {
		spi0 = &spi0;
		spi1 = &spi1;
		spi2 = &qspi0;
		spi3 = &qspi1;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <10000000>; /* 10M */
		bootph-pre-ram;
		cpu@0 {
			device_type = "cpu";
			reg = <0>;
			status = "okay";
			compatible = "riscv";
			riscv,isa = "rv64imafdcvsu";
			mmu-type = "riscv,sv39";
			bootph-pre-ram;
		};
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "simple-bus";
		ranges;
		bootph-pre-ram;

		intc: interrupt-controller@0018000000 {
			compatible = "riscv,plic0";
			reg = <0x00 0x18000000 0x0 0x04000000>;
			status = "okay";
		};

		dummy_apb: apb-clock {
			compatible = "fixed-clock";
			clock-frequency = <10000000>;  /* 10M */
			clock-output-names = "dummy_apb";
			#clock-cells = <0>;
			bootph-pre-ram;
		};

		dummy_ahb: ahb-clock {
			compatible = "fixed-clock";
			clock-frequency = <10000000>;  /* 10M */
			clock-output-names = "core";
			#clock-cells = <0>;
			bootph-pre-ram;
		};

		dummy_spi: spi-clock {
			compatible = "fixed-clock";
			clock-frequency = <10000000>;  /* 10M */
			clock-output-names = "dummy_spi";
			#clock-cells = <0>;
			bootph-pre-ram;
		};

		dummy_qspi: qspi-clock {
			compatible = "fixed-clock";
			clock-frequency = <10000000>;  /* 10M */
			clock-output-names = "dummy_qspi";
			#clock-cells = <0>;
			bootph-pre-ram;
		};

		dummy_uart_sclk: uart-sclk-clock {
			compatible = "fixed-clock";
			clock-frequency = <10000000>;  /* 10M */
			clock-output-names = "dummy_uart_sclk";
			#clock-cells = <0>;
			bootph-pre-ram;
		};

		dummy_gmac_clk: gmac-clk-clock {
			compatible = "fixed-clock";
			clock-frequency = <10000000>;
			clock-output-names = "dummy_gmac_clk";
			#clock-cells = <0>;
			bootph-pre-ram;
		};

		dummy_i2c_icclk: i2c-icclk-clock {
			compatible = "fixed-clock";
			clock-frequency = <10000000>;
			clock-output-names = "dummy_i2c_icclk";
			#clock-cells = <0>;
			bootph-pre-ram;
		};

		dummy_dpu_pixclk: dpu-pix-clock {
			compatible = "fixed-clock";
			clock-frequency = <74250000>;
			clock-output-names = "dummy_dpu_pixclk";
			#clock-cells = <0>;
			bootph-pre-ram;
		};

		dummy_dphy_refclk: dphy-ref-clock {
			compatible = "fixed-clock";
			clock-frequency = <24000000>;
			clock-output-names = "dummy_dpu_refclk";
			#clock-cells = <0>;
			bootph-pre-ram;
		};

		i2c0: i2c@02020000 {
			compatible = "snps,designware-i2c";
			reg = <0x00 0x02020000 0x0 0x1000>;
			clocks = <&dummy_i2c_icclk>;
			clock-frequency = <100000>;

			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c1: i2c@02021000{
			compatible = "snps,designware-i2c";
			reg = <0x00 0x02021000 0x0 0x1000>;
			clocks = <&dummy_i2c_icclk>;
			clock-frequency = <100000>;

			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c2: i2c@02022000{
			compatible = "snps,designware-i2c";
			reg = <0x00 0x02022000 0x0 0x1000>;
			clocks = <&dummy_i2c_icclk>;
			clock-frequency = <100000>;

			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c3: i2c@08415000{
			compatible = "snps,designware-i2c";
			reg = <0x00 0x08415000 0x0 0x1000>;
			clocks = <&dummy_i2c_icclk>;
			clock-frequency = <100000>;

			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c4: i2c@08416000{
			compatible = "snps,designware-i2c";
			reg = <0x00 0x08416000 0x0 0x1000>;
			clocks = <&dummy_i2c_icclk>;
			clock-frequency = <100000>;

			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c5: i2c@08417000{
			compatible = "snps,designware-i2c";
			reg = <0x00 0x08417000 0x0 0x1000>;
			clocks = <&dummy_i2c_icclk>;
			clock-frequency = <100000>;

			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c6: i2c@08418000{
			compatible = "snps,designware-i2c";
			reg = <0x00 0x08418000 0x0 0x1000>;
			clocks = <&dummy_i2c_icclk>;
			clock-frequency = <100000>;

			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c7: i2c@08419000{
			compatible = "snps,designware-i2c";
			reg = <0x00 0x08419000 0x0 0x1000>;
			clocks = <&dummy_i2c_icclk>;
			clock-frequency = <100000>;

			#address-cells = <1>;
			#size-cells = <0>;
		};

		serial@08401000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x08401000 0x0 0x400>;
			clocks = <&dummy_uart_sclk>;
			clock-names = "baudclk";
			reg-shift = <2>;
			reg-io-width = <4>;
			bootph-pre-ram;
		};

		gmac0: ethernet@02100000{
			compatible = "zhihe,p100-dwmac";
			reg = <0x00 0x02100000 0x0 0x10000>;
			clocks = <&dummy_gmac_clk>, <&dummy_gmac_clk>, <&dummy_gmac_clk>;
			clock-names = "master_bus", "mac-clk-rx", "mac-clk-tx";
			snps,pbl = <32>;
			snps,fixed-burst;

			phy-mode = "rgmii-id";
			phy-handle = <&phy_88E1111_a>;
			speed = <10>;
			status = "okay";
			mdio0 {
				#address-cells = <1>;
				#size-cells = <0>;
				compatible = "snps,dwmac-mdio";
				/* The value of phy reg is related to the number of supported phy (CONFIG_PHY_???) */
				phy_88E1111_a: ethernet-phy@1 {
					reg = <0x0>;
				};
			};
		};

		emmc: sdhci@00500000 {
			compatible = "zhihe,p100-dwcmshc";
			reg = <0x00 0x00500000 0x0 0x10000>;
			index = <0x0>;
			clocks = <&dummy_ahb>;       /* The item is invalid, but it must exist */
			clock-names = "core";
			clock-frequency = <10000000>;  /* 10M Base Clock */
			max-frequency = <400000>;    /* 400K Max emmc Clock */
			sdhci-caps-mask = <0x0 0x1000000>;
			mmc-hs200-1_8v;
			non-removable;
			no-sdio;
			no-sd;
			bus-width = <8>;
			voltage= "1.8v";
			pull_up;
			io_fixed_1v8;
			fifo-mode;
			bootph-pre-ram;
			status = "okay";
		};

		sdhci0: sd@00510000 {
			compatible = "zhihe,p100-dwcmshc";
			reg = <0x00 0x00510000 0x0 0x10000>;
			index = <0x1>;
			clocks = <&dummy_ahb>;
			clock-names = "core";
			clock-frequency = <10000000>;  /* 10M Base Clock */
			max-frequency = <10000000>;
			sd-uhs-sdr104;
			pull_up;
			bus-width = <4>;
			voltage= "3.3v";
			status = "okay";
		};

		qspi0: spi@01000000 {
			compatible = "zhihe,dw-apb-ssi";
			reg = <0x00 0x01000000 0x0 0x4000>;
			clocks = <&dummy_qspi>;
			clock-names = "dummy_qspi";
			num-cs = <1>;
			cs-gpios = <&gpio0_port 19 0>;
			spi-max-frequency = <1000000>;
			#address-cells = <1>;
			#size-cells =<0>;
			flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <1>;
				spi-max-frequency = <1000000>;
				spi-tx-bus-width = <4>;
				spi-rx-bus-width = <4>;
			};

			spi-flash@0 {
				compatible = "spi-nand";
				spi-max-frequency = <1000000>;
				#address-cells = <1>;
				#size-cells = <1>;
				spi-tx-bus-width = <4>;
				spi-rx-bus-width = <4>;
				reg = <0>;
			};
		};

		qspi1: spi@08428000 {
			compatible = "zhihe,dw-apb-ssi";
			reg = <0x00 0x08428000 0x0 0x4000>;
			clocks = <&dummy_qspi>;
			clock-names = "dummy_qspi";
			num-cs = <1>;
			cs-gpios = <&gpio2_port 29 0>;
			spi-max-frequency = <1000000>; /* <66000000>; */
			#address-cells = <1>;
			#size-cells =<0>;
			flash@1 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <1000000>;
				#address-cells = <1>;
				#size-cells = <1>;
				spi-tx-bus-width = <4>;
				spi-rx-bus-width = <4>;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <1>;
					#size-cells = <1>;
					partition@norboot0 {
						reg = <0x00000000 0x00100000>;
						label = "norboot0";
					};
					partition@norboot1 {
						reg = <0x00100000 0x00100000>;
						label = "norboot1";
					};
					partition@norenv {
						reg = <0x00200000 0x00040000>;
						label = "norenv";
					};
				};
			};

			spi-flash@1 {
				compatible = "spi-nand";
				spi-max-frequency = <1000000>;
				#address-cells = <1>;
				#size-cells = <1>;
				spi-tx-bus-width = <4>;
				spi-rx-bus-width = <4>;
				reg = <0>;
			};
		};

		spi0: spi@02023000 {
			compatible = "zhihe,dw-apb-ssi";
			reg = <0x00 0x02023000 0x0 0x1000>;
			clocks = <&dummy_spi>;
			clock-names = "dummy_spi";
			num-cs = <1>;
			cs-gpios = <&gpio1_port 7 0>;
			spi-max-frequency = <1000000>; /* <100000000>; */
			#address-cells = <1>;
			#size-cells = <0>;
			flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <1000000>;
			};
		};

		spi1: spi@08413000 {
			compatible = "zhihe,dw-apb-ssi";
			reg = <0x00 0x08413000 0x0 0x1000>;
			clocks = <&dummy_spi>;
			clock-names = "dummy_spi";
			num-cs = <1>;
			/* cs-gpios = <&gpio2_port 15 1>; */
			spi-max-frequency = <1000000>; /* <100000000>; */
			#address-cells = <1>;
			#size-cells = <0>;
		};

		gpio0: gpio@02012000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x00 0x02012000 0x0 0x1000>;
			clocks = <&dummy_apb>;
			#address-cells = <1>;
			#size-cells = <0>;

			gpio0_port: gpio@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <32>;
				reg = <0>;
			};
		};

		gpio1: gpio@02013000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x00 0x02013000 0x0 0x1000>;
			clocks = <&dummy_apb>;
			#address-cells = <1>;
			#size-cells = <0>;

			gpio1_port: gpio@1 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <18>;
				reg = <0>;
			};
		};

		gpio2: gpio@08410000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x00 0x08410000 0x0 0x1000>;
			clocks = <&dummy_apb>;
			#address-cells = <1>;
			#size-cells = <0>;

			gpio2_port: gpio@2 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <32>;
				reg = <0>;
			};
		};

		gpio3: gpio@08412000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x00 0x08412000 0x0 0x1000>;
			clocks = <&dummy_apb>;
			#address-cells = <1>;
			#size-cells = <0>;

			gpio3_port: gpio@3 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <11>;
				reg = <0>;
			};
		};

		gpio4: gpio@00550000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x00 0x00550000 0x0 0x1000>;
			clocks = <&dummy_apb>;
			#address-cells = <1>;
			#size-cells = <0>;

			gpio4_port: gpio@4 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <6>;
				reg = <0>;
			};
		};
	};

	chosen {
		bootargs = "console=ttyS4,115200";
		stdout-path = "/soc/serial@08401000:115200";
	};
};
