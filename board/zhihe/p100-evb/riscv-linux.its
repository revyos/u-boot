/dts-v1/;

/ {
	description = "ZhiHe P100 FIT image";
	#address-cells = <1>;
 
	images {
		kernel-1 {
			description = "Linux Kernel";
			data = /incbin/("replace-path/Image");
			type = "kernel";
			os = "linux";
			arch = "riscv";
			compression = "none";
			load = <0x80200000>;
			entry = <0x80200000>;
			invalid_hash {
				algo = "sha256";
			};
		};
	
		fdt-1 {
			description = "Device Tree";
			data = /incbin/("replace-path/replace-dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x9ff00000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		opensbi-1 {
			description = "RISC-V OpenSBI";
			data = /incbin/("replace-path/fw_dynamic.bin");
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "none";
			load = <0x80000000>;
			entry = <0x80000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		u-boot-1 {
			description = "U-Boot";
			data = /incbin/("replace-path/u-boot.bin");
			type = "firmware";
			os = "u-boot";
			arch = "riscv";
			compression = "none";
			load = <0x90000000>;
			entry = <0x90000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		aon-1 {
			description = "AON";
			data = /incbin/("replace-path/firmware/p100_aon.bin");
			type = "firmware";
			arch = "riscv";
			compression = "none";
			load = <0x308f8000>;
			entry = <0x308f8000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		initrd-1 {
			description = "INITRD";
			data = /incbin/("replace-path/initrd");
			type = "firmware";
			arch = "riscv";
			compression = "none";
			load = <0x9e000000>;
			entry = <0x9e000000>;
			invalid_hash {
				algo = "sha256";
			};
		};
	};


	configurations {
		default = "conf-1";
		conf-1 {
			description = "Default Configuration";
			fdt = "fdt-1";
			firmware = "opensbi-1";
			kernel = "kernel-1";
			uboot = "u-boot-1";
			aon = "aon-1";
			initrd = "initrd-1";
			loadables = "u-boot-1", "kernel-1", "aon-1", "initrd-1";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "kernel", "fdt", "firmware", "uboot", "aon", "initrd";
			};
		};
	};
};
