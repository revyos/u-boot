/dts-v1/;

/ {
	description = "ZhiHe P100 FIT image";
	#address-cells = <1>;
 
	images {
		kernel-1 {
			description = "Linux Kernel";
			data = /incbin/("../../../../kernel/arch/riscv/boot/Image");
			type = "kernel";
			os = "invalid";
			arch = "riscv";
			compression = "none";
			load = <0x80200000>;
			entry = <0x80200000>;
			hash {
				algo = "sha256";
			};
		};
	
		fdt-1 {
			description = "Device Tree";
			data = /incbin/("../../../../kernel/arch/riscv/boot/dts/zhihe/p100-haps.dtb");
			type = "flat_dt";
			arch = "riscv";
			load = <0x9ff00000>;
			data-size-unciphered = "0xa693";
			cipher {
				algo = "aes256";
				key-name-hint = "aes_key";
				iv = <0x723927f0 0xb547ef19 0x0188af4c 0x85dd4e7d>;
				iv-name-hint = "aes_iv";
			};
			hash {
				algo = "sha256";
			};
		};

		opensbi-1 {
			description = "RISC-V OpenSBI";
			data = /incbin/("../../../../opensbi/build/platform/generic/firmware/fw_dynamic.bin");
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "none";
			load = <0x80000000>;
			entry = <0x80000000>;
			hash {
				algo = "sha256";
			};
		};

		u-boot-1 {
			description = "U-Boot";
			data = /incbin/("../../../../u-boot/u-boot.bin");
			type = "firmware";
			os = "u-boot";
			arch = "riscv";
			compression = "none";
			load = <0x90000000>;
			entry = <0x90000000>;
			hash {
				algo = "sha256";
			};
		};
	};
 
	configurations {
		default = "conf-1";
		conf-1 {
			description = "Default Configuration";
			fdt = "fdt-1";
			firmware = "opensbi-1";
			kernel = "kernel-1";
			loadables = "u-boot-1", "kernel-1";
			signature {
				algo = "sha256,rsa2048";
				key-name-hint = "dev";
				sign-images = "kernel", "fdt", "firmware";
			};
		};
	};
};
