/dts-v1/;

/ {
	description = "ZhiHe A200 Linux FIT image";
	#address-cells = <1>;
 
	images {
		kernel-1 {
			description = "Linux Kernel";
			data = /incbin/("replace-path/Image");
			type = "kernel";
			os = "linux";
			arch = "riscv";
			compression = "none";
			load = <0x00200000>;
			entry = <0x00200000>;
			invalid_hash {
				algo = "sha256";
			};
		};
	
		fdt-1 {
			description = "Device Tree";
			data = /incbin/("replace-path/replace-dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x1ff00000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		opensbi-1 {
			description = "RISC-V OpenSBI";
			data = /incbin/("replace-path/fw_dynamic.bin");
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "none";
			load = <0x00000000>;
			entry = <0x00000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		u-boot-1 {
			description = "U-Boot";
			data = /incbin/("replace-path/u-boot.bin");
			type = "firmware";
			os = "u-boot";
			arch = "riscv";
			compression = "none";
			load = <0x10000000>;
			entry = <0x10000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		aon-1 {
			description = "AON";
			data = /incbin/("replace-path/light_aon_fpga.bin");
			type = "firmware";
			arch = "riscv";
			compression = "none";
			load = <0xff 0xffef8000>;
			entry = <0xff 0xffef8000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		initrd-1 {
			description = "INITRD";
			data = /incbin/("replace-path/initrd");
			type = "firmware";
			arch = "riscv";
			compression = "none";
			load = <0x1e000000>;
			entry = <0x1e000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		audio-1 {
			description = "Audio";
			data = /incbin/("replace-path/light_c906_audio.bin");
			type = "firmware";
			arch = "riscv";
			compression = "none";
			load = <0x32000000>;
			entry = <0x32000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		str-1 {
			description = "STR";
			data = /incbin/("replace-path/str.bin");
			type = "firmware";
			arch = "riscv";
			compression = "none";
			load = <0xff 0xe0000000>;
			entry = <0xff 0xe0000000>;
			invalid_hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "Default Configuration";
			fdt = "fdt-1";
			firmware = "opensbi-1";
			kernel = "kernel-1";
			uboot = "u-boot-1";
			aon = "aon-1";
			initrd = "initrd-1";
			audio = "audio-1";
			str = "str-1";
			loadables = "u-boot-1", "kernel-1", "aon-1", "initrd-1", "audio-1", "str-1";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "kernel", "fdt", "firmware", "uboot", "aon", "initrd", "audio-1", "str-1";
			};
		};
	};
};
