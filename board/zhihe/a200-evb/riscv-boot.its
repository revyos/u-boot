/dts-v1/;

/ {
	description = "ZhiHe A200 Boot FIT image";
	#address-cells = <1>;
 
	images {
		fdt-licheepi {
			description = "LicheePi Device Tree";
			data = /incbin/("replace-path/th1520-lichee-pi-4a.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x0c000000>;
			hash {
				algo = "sha256";
			};
		};

		fdt-evb {
			description = "DEV Device Tree";
			data = /incbin/("replace-path/a200-evb.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x0c000000>;
			hash {
				algo = "sha256";
			};
		};

		opensbi-1 {
			description = "RISC-V OpenSBI";
			data = /incbin/("replace-path/fw_dynamic.bin.gz");
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "gzip";
			load = <0x00000000>;
			entry = <0x00000000>;
			hash {
				algo = "sha256";
			};
		};

		u-boot-1 {
			description = "U-Boot";
			data = /incbin/("replace-path/u-boot.bin.gz");
			type = "firmware";
			os = "u-boot";
			arch = "riscv";
			compression = "gzip";
			load = <0x10000000>;
			entry = <0x10000000>;
			hash {
				algo = "sha256";
			};
		};

		aon-1 {
			description = "AON";
			data = /incbin/("replace-path/light_aon_fpga.bin");
			type = "firmware";
			arch = "riscv";
			compression = "none";
			load = <0xff 0xffef8000>;
			entry = <0xff 0xffef8000>;
			hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "th1520-lichee-pi-4a";
		th1520-lichee-pi-4a {
			description = "Default Configuration";
			fdt = "fdt-licheepi";
			firmware = "opensbi-1";
			loadables = "u-boot-1", "aon-1";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "fdt", "firmware";
			};
		};

		a200-evb {
			description = "Default Configuration";
			fdt = "fdt-evb";
			firmware = "opensbi-1";
			loadables = "u-boot-1", "aon-1";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "fdt", "firmware";
			};
		};
	};
};
