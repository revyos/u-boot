/dts-v1/;

/ {
	description = "ZhiHe A210 Boot FIT image";
	#address-cells = <1>;

	images {
		tee-1 {
			description = "optee-os";
			data = /incbin/("replace-path/tee.bin.gz");
			type = "firmware";
			os = "tee";
			arch = "riscv";
			compression = "gzip";
			load = <0x88000000>;
			entry = <0x88000000>;
			invalid_hash {
					algo = "sha256";
			};
		};
		fdt-evb {
			description = "EVB Device Tree";
			data = /incbin/("replace-path/a210-evb-sec.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x8c000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		fdt-dev {
			description = "DEV Device Tree";
			data = /incbin/("replace-path/a210-dev-sec.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x8c000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		opensbi-1 {
			description = "RISC-V OpenSBI";
			data = /incbin/("replace-path/fw_dynamic.bin.gz");
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "gzip";
			load = <0x80000000>;
			entry = <0x80000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		u-boot-1 {
			description = "U-Boot";
			data = /incbin/("replace-path/u-boot.bin.gz");
			type = "firmware";
			os = "u-boot";
			arch = "riscv";
			compression = "gzip";
			load = <0x90000000>;
			entry = <0x90000000>;
			invalid_hash {
				algo = "sha256";
			};
		};

		aon-1 {
			description = "AON";
			data = /incbin/("replace-path/a210-aon.bin");
			type = "firmware";
			arch = "riscv";
			compression = "none";
			load = <0x308f8000>;
			entry = <0x308f8000>;
			invalid_hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "a210-evb-sec";
		a210-evb-sec {
			description = "EVB Configuration";
			fdt = "fdt-evb";
			firmware = "opensbi-1";
			tee = "tee-1";
			loadables = "u-boot-1", "aon-1", "tee-1";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "fdt", "firmware", "uboot", "aon", "tee";
			};
		};

		a210-dev-sec {
			description = "DEV Configuration";
			fdt = "fdt-dev";
			firmware = "opensbi-1";
			tee = "tee-1";
			loadables = "u-boot-1", "aon-1", "tee-1";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "fdt", "firmware", "uboot", "aon", "tee";
			};
		};
	};
};
