/dts-v1/;

/ {
	description = "ZhiHe A210 Boot FIT image";
	#address-cells = <1>;

	images {
		fdt-evb {
			description = "EVB Device Tree";
			data = /incbin/("replace-path/a210-evb.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x8c000000>;
			hash {
				algo = "sha256";
			};
		};

		fdt-dev {
			description = "DEV Device Tree";
			data = /incbin/("replace-path/a210-dev.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x8c000000>;
			hash {
				algo = "sha256";
			};
		};

		fdt-evb-d2d {
			description = "EVB D2D Device Tree";
			data = /incbin/("replace-path/a210-evb-d2d.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			load = <0x8c000000>;
			hash {
				algo = "sha256";
			};
		};

		opensbi-1 {
			description = "RISC-V OpenSBI";
			data = /incbin/("replace-path/fw_dynamic.bin.gz");
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "gzip";
			load = <0x80000000>;
			entry = <0x80000000>;
			hash {
				algo = "sha256";
			};
		};

		u-boot-1 {
			description = "U-Boot";
			data = /incbin/("replace-path/u-boot.bin.gz");
			type = "firmware";
			os = "u-boot";
			arch = "riscv";
			compression = "gzip";
			load = <0x90000000>;
			entry = <0x90000000>;
			hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "a210-evb";
		a210-evb {
			description = "EVB Configuration";
			fdt = "fdt-evb";
			firmware = "opensbi-1";
			loadables = "u-boot-1";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "fdt", "firmware", "uboot";
			};
		};

		a210-dev {
			description = "DEV Configuration";
			fdt = "fdt-dev";
			firmware = "opensbi-1";
			loadables = "u-boot-1";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "fdt", "firmware", "uboot";
			};
		};

		a210-evb-d2d {
			description = "EVB D2D Configuration";
			fdt = "fdt-evb-d2d";
			firmware = "opensbi-1";
			loadables = "u-boot-1";
			invalid_signature {
				algo = "sha256,rsa2048";
				key-name-hint = "signature_key_name";
				sign-images = "fdt", "firmware", "uboot";
			};
		};
	};
};
